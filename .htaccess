RewriteEngine On
RewriteBase /codes/pixelforge/

# Allow specific API endpoints
RewriteRule ^(api/auth\.php|api/game\.php|api/pixels\.php|api/canvas\.php|api/ws-control\.php|admin/api\.php)$ - [L]

# Admin panel
RewriteRule ^admin$ /codes/pixelforge/admin/index.html [L]

# Block direct access to api/ directory
RewriteRule ^api/(.*)$ - [F,L]

# Block access to includes/ directory
RewriteRule ^includes/ - [F,L]

# Block access to database/ directory
RewriteRule ^database/ - [F,L]

# Block access to logs/ directory
RewriteRule ^logs/ - [F,L]

# New folder-based routes (clean URLs)
# / -> landing page (root index.html)
# /home/ -> dashboard
# /game/ -> match-3 play
# /world/ -> canvas world
# /rankings/ -> rankings
# /profile/ -> player profile

# Backward compatibility: old clean URLs redirect to new structure
RewriteRule ^game$ /game/ [R=301,L]
RewriteRule ^canvas$ /world/ [R=301,L]
RewriteRule ^login$ / [R=301,L]
RewriteRule ^register$ / [R=301,L]
RewriteRule ^leaderboard$ /rankings/ [R=301,L]
RewriteRule ^profile$ /profile/ [R=301,L]

# Backward compatibility: old .html files redirect to new structure
RewriteRule ^game\.html$ /game/ [R=301,L]
RewriteRule ^canvas\.html$ /world/ [R=301,L]
RewriteRule ^leaderboard\.html$ /rankings/ [R=301,L]
RewriteRule ^profile\.html$ /profile/ [R=301,L]
RewriteRule ^index\.html$ / [R=301,L]

# Security headers
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set X-XSS-Protection "1; mode=block"
Header set Referrer-Policy "strict-origin-when-cross-origin"

# Set default charset
AddDefaultCharset UTF-8

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
</IfModule>
